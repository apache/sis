<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- A Stroke drawn as repeated Mark graphics through GraphicStroke, with InitialGap/Gap. -->
<se:LineSymbolizer xmlns:se="http://www.opengis.net/se" xmlns:ogc="http://www.opengis.net/ogc">
    <se:Stroke>
        <se:GraphicStroke>
            <se:Graphic>
                <se:Mark>
                    <se:WellKnownName>circle</se:WellKnownName>
                    <se:Fill>
                        <se:SvgParameter name="fill"><ogc:Literal>#FF0000</ogc:Literal></se:SvgParameter>
                    </se:Fill>
                </se:Mark>
                <se:Size><ogc:Literal>6</ogc:Literal></se:Size>
            </se:Graphic>
            <se:InitialGap><ogc:Literal>2.5</ogc:Literal></se:InitialGap>
            <se:Gap><ogc:Literal>10.0</ogc:Literal></se:Gap>
        </se:GraphicStroke>
    </se:Stroke>
</se:LineSymbolizer>
