<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- A LayerFeatureConstraints restricting a layer to one feature type, a filter and named extents. -->
<NamedLayer xmlns="http://www.opengis.net/sld" xmlns:ogc="http://www.opengis.net/ogc">
    <Name>named_layer</Name>
    <LayerFeatureConstraints>
        <FeatureTypeConstraint>
            <FeatureTypeName>the_feature_type_name</FeatureTypeName>
            <ogc:Filter>
                <ogc:PropertyIsGreaterThanOrEqualTo>
                    <ogc:PropertyName>num_lanes</ogc:PropertyName>
                    <ogc:Literal>4</ogc:Literal>
                </ogc:PropertyIsGreaterThanOrEqualTo>
            </ogc:Filter>
            <Extent><Name>extent_name</Name><Value>extent_value</Value></Extent>
        </FeatureTypeConstraint>
    </LayerFeatureConstraints>
</NamedLayer>
