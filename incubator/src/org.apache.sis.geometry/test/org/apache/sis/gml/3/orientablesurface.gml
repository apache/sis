<?xml version="1.0" encoding="UTF-8"?>
<gml:OrientableSurface xmlns:gml="http://www.opengis.net/gml/3.2" srsName="EPSG:4326" orientation="-">
    <gml:baseSurface>
        <gml:Polygon>
            <gml:exterior>
                <gml:LinearRing>
                    <gml:posList srsDimension="2">0.0 0.0 10.0 0.0 10.0 10.0 0.0 10.0 0.0 0.0</gml:posList>
                </gml:LinearRing>
            </gml:exterior>
        </gml:Polygon>
    </gml:baseSurface>
</gml:OrientableSurface>
